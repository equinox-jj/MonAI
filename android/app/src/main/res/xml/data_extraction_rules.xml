<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keeps the session token out of cloud backup and device transfer:
     its Keystore key stays on this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
