<?xml version="1.0" encoding="utf-8"?><!--
   Android 11 and lower. Backup is off (android:allowBackup="false"); these
   rules also exclude everything in case it is turned back on, since the app's
   local data includes the access token.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
