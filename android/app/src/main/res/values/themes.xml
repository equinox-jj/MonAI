<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat so AppCompatDelegate can apply the language picked in Settings on every API level. -->
    <style name="Theme.MonAI" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Launch theme: the system splash, held by MainActivity until the session is read. -->
    <style name="Theme.MonAI.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.MonAI</item>
    </style>
</resources>