# Copy to .env and fill in. docker compose -f docker-compose.dev.yml reads this file.

# App
APP_ENV=development
API_PORT=8080
# Comma-separated reverse proxy IPs/CIDRs whose X-Forwarded-For is trusted for
# the client IP (rate limits). Leave empty when clients connect directly.
# Required by docker-compose.prod.yml (Traefik's network CIDR).
TRUSTED_PROXIES=

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=monai
POSTGRES_USER=monai
POSTGRES_PASSWORD=change_me

# The API's own role (created by db-init in docker compose): it can read and
# write rows but not change the schema. Use URL-safe characters
# (openssl rand -hex 24), since it is placed in a connection URL.
DB_APP_USER=monai_app
DB_APP_PASSWORD=change_me_app

# Used when running the API or migrations from your machine, as the owner
# (docker compose points the api container at DB_APP_USER instead).
DATABASE_URL=postgres://monai:change_me@localhost:5432/monai?sslmode=disable&timezone=UTC
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Root credentials: used only by minio-init (docker compose), never by the API.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_min_8_chars
# The API's own MinIO user, limited to the two buckets; minio-init creates it.
# Required in production. Secret key: at least 8 characters.
MINIO_ACCESS_KEY=monai-api
MINIO_SECRET_KEY=change_me_min_8_chars
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Bucket for avatars and receipts
MINIO_BUCKET_PRIVATE=expense-private
# Bucket for provider logos
MINIO_BUCKET_PUBLIC=expense-public
# Base URL clients load public files (provider logos) from. Defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_URL=http://localhost:9000

# JWT authentication (generate a secret with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret
JWT_ISSUER=monai
JWT_ACCESS_TTL=168h

# AI provider. Leave GEMINI_API_KEY empty to disable /ai/* (they return 503).
# The free tier may use inputs to improve Google's models, so the API sends
# only the text, today's date, the timezone and wallet/category ID-name pairs.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-lite-latest
# How long to wait for a receipt parse. Quick-add phrases stop at 3s (or this,
# if shorter), since the app falls back to its own parser by then.
GEMINI_TIMEOUT=10s
