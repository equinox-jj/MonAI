# Copy to .env and fill in. docker compose reads this file.

# App
APP_ENV=development
API_PORT=8080

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=monai
POSTGRES_USER=monai
POSTGRES_PASSWORD=change_me

# Used when running the API or migrations from your machine (docker compose
# overrides it for the api container to point at the postgres service).
DATABASE_URL=postgres://monai:change_me@localhost:5432/monai?sslmode=disable&timezone=UTC

# MinIO
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_min_8_chars
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_PRIVATE=expense-private
MINIO_BUCKET_PUBLIC=expense-public
# Base URL clients load public files (provider logos) from. Defaults to MINIO_ENDPOINT.
MINIO_PUBLIC_URL=http://localhost:9000

# JWT authentication (generate a secret with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret
JWT_ISSUER=monai
JWT_ACCESS_TTL=168h

# AI provider
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_gemini_model
